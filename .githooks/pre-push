#!/bin/sh
# push直前のフック。検査はしない——検査はCI（ci.yml・docs-consistency.yml）が持つ。
#
# 検査の置き場（docs/conventions/testing.md「検査の置き場」）: 手元では直接触った範囲だけを
# 確かめ、前提になっているテストと静的検査は作業ブランチ（orch/**）のCIが回し、本番へ出る前の
# 検査はmasterのCIが持つ（通るまでbackendのデプロイは起動しない）。CIと同じ検査をここにも
# 置くと、同じ答えをpushのたびに開発機で買い直すことになる。
#
# ここに残すのは、CIにはできないことだけ:
# - 並行実行の停止ファイルがある間、pushを拒否する
# - masterのCIが赤いままなら知らせる（pushは止めない）
#
# 有効化: git config core.hooksPath .githooks
# **相対パスで指定すること。** この設定は本体とworktreeで共有されるため、絶対パスを
# 入れると全worktreeが本体のチェックアウトを見る。本体がこのディレクトリを持たない
# ブランチに居ると、gitは黙ってフックを飛ばす（門があるのに一度も走らない状態になる）。

set -eu

# 並行実行の停止ファイル（docs/conventions/orchestration.md「止める手段の段階」）。
# 置かれている間はpushを拒否する——エージェントが指示に従わなくても、masterへ何も出さない。
if [ -e "$(git rev-parse --git-common-dir)/orchestration/STOP" ]; then
    printf '\n[pre-push] 停止ファイル（orchestration/STOP）があるためpushを拒否します\n' >&2
    exit 1
fi

# 作業ブランチ（orch/**）だけへのpushなら、ここで終わる。gitは標準入力で
# 「<ローカルref> <ローカルsha> <リモートref> <リモートsha>」を1行ずつ渡す。
OTHER=0
while read -r _lref _lsha rref _rsha; do
    case "${rref:-}" in refs/heads/orch/*) ;; *) OTHER=1 ;; esac
done
[ "$OTHER" -eq 1 ] || exit 0

# masterのCIが赤いままなら知らせる（pushは止めない。赤の原因が自分とは限らない）。
for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1; then "$c" scripts/check_master_ci.py || true; break; fi
done
exit 0
