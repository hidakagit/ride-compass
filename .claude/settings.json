{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/orchestration/hook.sh\"; [ -f \"$f\" ] || exit 0; . \"$f\"",
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 1800,
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/orchestrate.py\" slot hook-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/orchestrate.py\" slot hook-remove"
          }
        ]
      }
    ]
  }
}
