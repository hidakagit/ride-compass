# Docker Compose用の環境変数
# ローカルでfrontend/backendを個別起動する場合は、それぞれの
# frontend/.env.example, backend/.env.example を参照してください。

# Postgres
POSTGRES_USER=ridecompass
POSTGRES_PASSWORD=ridecompass
POSTGRES_DB=ridecompass

# Backend
DATABASE_URL=postgresql://ridecompass:ridecompass@postgres:5432/ridecompass
CORS_ALLOWED_ORIGINS=http://localhost:3000

# /api/routes/generateのルーティングエンジン切り替え。openrouteservice（既定、外部APIキー方式）
# またはroad_graph（自前Road Graph+NetworkX、APIキー不要だがルーティング自体は開発中）。
# 詳細はdocs/architecture.md参照
ROUTING_ENGINE=openrouteservice
OPENROUTESERVICE_API_KEY=
# Road Graph永続化（PostGIS）をランタイムのread-throughキャッシュとして使うか（既定false）
ROAD_GRAPH_USE_REPOSITORY=false
# ROAD_GRAPH_USE_REPOSITORY=true時、PostGIS取込範囲外・DB障害でOverpassへフォールバックするか
OVERPASS_FALLBACK_ENABLED=true
# 調査用デバッグモード。外部API呼び出し・タイルキャッシュのhit/missをDEBUGログに出力する
DEBUG_MODE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
