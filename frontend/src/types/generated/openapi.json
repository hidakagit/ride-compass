            "title": "Routes"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "conditions": {
            "$ref": "#/components/schemas/GenerationConditions"
          }
        },
        "type": "object",
        "required": [
          "routes",
          "engine",
          "conditions"
        ],
        "title": "RouteGenerateResponse"
      },
      "RoutePreferenceWeights": {
        "properties": {
          "elevation_weight": {
            "type": "number",
            "minimum": 0.0,
            "title": "Elevation Weight"
          },
          "road_weight": {
            "type": "number",
            "minimum": 0.0,
