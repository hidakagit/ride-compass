          "longitude",
          "distance_km"
        ],
        "title": "RouteGenerateRequest"
      },
      "RouteGenerateResponse": {
        "properties": {
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteCandidate"
            },
