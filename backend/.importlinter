# Layer contract of backend/app. What each layer owns and why the order is this one:
# docs/architecture/directory-layout.md "backend". Keep this file ASCII only
# (import-linter reads it with the OS default encoding, cp932 on Japanese Windows).
[importlinter]
root_package = app
# Needed by the forbidden contract below to name PIL and io (grimp includes the
# standard library among external packages).
include_external_packages = True

[importlinter:contract:layers]
name = backend layers (docs/architecture/directory-layout.md)
type = layers
containers =
    app
layers =
    main
    api
    services | batch
    infrastructure
    config | version
    domain
exhaustive = true

# Redis keys, value shapes and the get_json/set_json callers belong to infrastructure
# (docs/architecture/directory-layout.md "backend", docs/conventions/caching.md).
# Reaching Redis through an infrastructure module is the intended path, so only
# direct imports are checked.
[importlinter:contract:redis-in-infrastructure]
name = Redis connection is read only by infrastructure
type = forbidden
source_modules =
    app.main
    app.api
    app.services
    app.batch
forbidden_modules =
    app.infrastructure.redis_client
    app.infrastructure.redis_json_cache
allow_indirect_imports = True

# Disk cache keys and the check/fetch/store skeleton belong to infrastructure, as for
# Redis (docs/conventions/caching.md). The admin "clear everything" of the basemap
# router is the one operator action caching.md keeps on the raw cache.
[importlinter:contract:disk-cache-in-infrastructure]
name = Disk caches are read only by infrastructure
type = forbidden
source_modules =
    app.main
    app.api
    app.services
    app.batch
forbidden_modules =
    app.infrastructure.tile_cache
    app.infrastructure.tile_persistent_cache
ignore_imports =
    app.api.routers.basemap -> app.infrastructure.tile_cache
allow_indirect_imports = True

[importlinter:contract:domain-formats]
name = domain does not read external formats (docs/architecture/directory-layout.md)
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    PIL
    io
