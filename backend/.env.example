# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (Road Graph/Road Attributeの永続化先。PostGIS必須。SQLAlchemyの非同期エンジン
# 用にasyncpgドライバを明示する必要があるため、postgresql:// ではなく postgresql+asyncpg://
# を使う。ElevationAttributeServiceへrepositoryを明示的に注入した場合のみ使われる。
# GraphServiceは改善計画T222でrepository必須（このURLへの接続必須）へ一本化済みだが、
# ROUTING_ENGINE=openrouteserviceのままならGraphServiceのメソッドは呼ばれないため、
# 接続できないDATABASE_URLのままでも実害は無い）
DATABASE_URL=postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass

# Road Graph永続化（PostGIS）をランタイムのread-throughキャッシュとして使うか。
# trueにするとElevationAttributeService/RegionService/AccidentService・ORSエンジンの
# 路面評価用repositoryが注入され、PBF取込バッチ（app/batch/import_pbf.py）で取得済み
# マークした範囲では地域路面レイヤーのタイル生成等がPostGISのみで完結する
# （Overpassフォールバックは改善計画T22で撤去済み。取込範囲外・DB障害時は空タイル/
# データ未整備扱いになる）。falseの場合、地域路面レイヤーは常に空タイルを返す。
# **ROUTING_ENGINE=road_graphを使うにはこの設定に関わらずDATABASE_URLへ実際に接続できる
# 必要がある**（GraphServiceは改善計画T222でrepository必須へ一本化済みのため、
# この設定をfalseにしてもGraphServiceはDBなしにならない。DBなし構成で使えるのは
# ROUTING_ENGINE=openrouteserviceのときのみ）。
ROAD_GRAPH_USE_REPOSITORY=false

# Routing engine for /api/routes/generate: "openrouteservice" (external API key,
# Road Graph移行前の実装) or "road_graph" (self-hosted Road Graph + scipy.sparse.csgraph
# Dijkstra, no API key but requires DATABASE_URLへの接続 — 改善計画T222でDBなし構成を
# 撤去済み。routing itself is still under active development). See
# docs/architecture.md for details.
ROUTING_ENGINE=openrouteservice
OPENROUTESERVICE_API_KEY=

# Weather (Open-Meteo requires no API key)
# OPEN_METEO_BASE_URL: defaults to Open-Meteo directly (local dev). Render's shared
# outbound IP gets rate-limited (429) by Open-Meteo because of other tenants sharing
# the same IP pool; production points this at a relay proxy (nginx on the
# self-hosted Oracle Cloud VM, see docs/osm-pbf-import.md and
# app/infrastructure/weather_client.py) that has its own dedicated IP.
# OPEN_METEO_BASE_URL=http://<oracle-vm-ip>:8080/v1/forecast

# Basemap proxy (/api/basemap): must match the origin the browser sees the
# frontend at (Next.js proxies this path to the backend, see next.config.ts).
# Default matches local dev (frontend on :3000). Leave as-is unless the
# frontend is served from a different host/port.
BASEMAP_PUBLIC_BASE_URL=http://localhost:3000/api/basemap

# Debug mode: logs external API calls (Open-Meteo/Overpass/OpenFreeMap) and tile
# cache hit/miss per event to stdout at DEBUG level. Off by default; requires a
# server restart to take effect.
DEBUG_MODE=false

# --- 本番/開発プロファイル一覧（改善計画T20、複雑度平衡レビューI-9対応） ---
# 「正の構成」が複数文書に分散していたため、代表的なプロファイルの値をここへ集約する。
# このファイル自体の既定値は「開発（DBなし）」プロファイル。
#
# | 変数                     | 本番（Render+Supabase）      | 開発（ネイティブPG）         | 開発（DBなし・既定） |
# |--------------------------|-------------------------------|-------------------------------|------------------------|
# | DATABASE_URL             | Supabase Session pooler URL   | localhost:5432/ridecompass    | （未接続でも動作）      |
# | ROAD_GRAPH_USE_REPOSITORY| true                          | true                           | false                   |
# | ROUTING_ENGINE           | openrouteservice（既定）      | 任意                           | openrouteservice必須※    |
# | OPEN_METEO_BASE_URL      | Oracle VM上のリレープロキシ   | 未設定（Open-Meteo直叩き）    | 未設定（Open-Meteo直叩き） |
#
# ※改善計画T222でGraphServiceのDBなし構成（Overpassから都度構築する経路）を撤去したため、
# 「開発（DBなし）」プロファイルではROUTING_ENGINE=road_graphは選べない
# （GraphServiceがDATABASE_URLへの実接続を必要とし、道路グラフ取得の都度失敗する）。
#
# 【DBなし構成の評価縮退に注意】（複雑度平衡レビュー第4回R-9対応）: ROAD_GRAPH_USE_REPOSITORY=false
# では、改善計画T21（評価のエンジン非依存化）以降、openrouteserviceエンジンでも路面・停止密度の
# 評価が自前DBの空間マッチに依存するため全区間Noneになる（ルート生成自体・距離/標高/風の評価は
# 動作する）。あわせて地域路面レイヤー（road-surface-tiles）も常に空タイルになる
# （改善計画T22でOverpassフォールバックを撤去したため）。ローカルでの動作確認だけなら
# 問題ないが、評価品質・路面レイヤー表示を確認したい場合はROAD_GRAPH_USE_REPOSITORY=true
# （ネイティブPG等、DB接続あり）にすること。
#
# 開発機でローカルDBを使う場合は、.envは変更せず環境変数で上書きする運用にしている
# （例: PowerShellで `$env:DATABASE_URL = "postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass"`）。
# Overpassフォールバック撤去の経緯はdocs/decisions/pre-static-attributes-gate.md 決定2改定参照。
