# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (Road Graph/Road Attributeの永続化先。PostGIS必須。SQLAlchemyの非同期エンジン
# 用にasyncpgドライバを明示する必要があるため、postgresql:// ではなく postgresql+asyncpg://
# を使う。GraphService/ElevationAttributeServiceへrepositoryを明示的に注入した場合のみ
# 使われ、それ以外の既存機能はこの値が無くても動作する）
DATABASE_URL=postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass

# Road Graph永続化（PostGIS）をランタイムのread-throughキャッシュとして使うか。
# trueにするとGraphService/ElevationAttributeService/RegionServiceへrepositoryが注入され、
# PBF取込バッチ（app/batch/import_pbf.py）で取得済みマークした範囲では、road_graphルート
# 生成と地域路面レイヤーのタイル生成がOverpassなしで完結する。DATABASE_URLのDBへ実際に
# 接続できる環境でのみ有効化すること。
ROAD_GRAPH_USE_REPOSITORY=false

# ROAD_GRAPH_USE_REPOSITORY=true時、PostGISの取込範囲外・DB障害でOverpassへフォール
# バックするか。falseにするとOverpass問い合わせが完全に停止し、範囲外の路面タイルは
# 空になる（取込範囲・データ品質に確信が持ててから切り替える。docs/osm-pbf-import.md）。
OVERPASS_FALLBACK_ENABLED=true

# Routing engine for /api/routes/generate: "openrouteservice" (external API key,
# Road Graph移行前の実装) or "road_graph" (self-hosted Road Graph + NetworkX Dijkstra,
# no API key but routing itself is still under active development). See
# docs/architecture.md for details.
ROUTING_ENGINE=openrouteservice
OPENROUTESERVICE_API_KEY=

# Weather (Open-Meteo requires no API key)

# Basemap proxy (/api/basemap): must match the origin the browser sees the
# frontend at (Next.js proxies this path to the backend, see next.config.ts).
# Default matches local dev (frontend on :3000). Leave as-is unless the
# frontend is served from a different host/port.
BASEMAP_PUBLIC_BASE_URL=http://localhost:3000/api/basemap

# Debug mode: logs external API calls (Open-Meteo/Overpass/OpenFreeMap) and tile
# cache hit/miss per event to stdout at DEBUG level. Off by default; requires a
# server restart to take effect.
DEBUG_MODE=false

# --- 本番/開発プロファイル一覧（改善計画T20、複雑度平衡レビューI-9対応） ---
# 「正の構成」が複数文書に分散していたため、代表的なプロファイルの値をここへ集約する。
# このファイル自体の既定値は「開発（DBなし）」プロファイル。
#
# | 変数                     | 本番（Render+Supabase）      | 開発（ネイティブPG）         | 開発（DBなし・既定） |
# |--------------------------|-------------------------------|-------------------------------|------------------------|
# | DATABASE_URL             | Supabase Session pooler URL   | localhost:5432/ridecompass    | （未接続でも動作）      |
# | ROAD_GRAPH_USE_REPOSITORY| true                          | true                           | false                   |
# | OVERPASS_FALLBACK_ENABLED| false                         | true（PBF未取込範囲の補完用） | true（無意味・常時Overpass）|
# | ROUTING_ENGINE           | openrouteservice（既定）      | 任意                           | openrouteservice        |
#
# 開発機でローカルDBを使う場合は、.envは変更せず環境変数で上書きする運用にしている
# （例: PowerShellで `$env:DATABASE_URL = "postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass"`）。
# フォールバック撤去（改善計画T22）の条件はdocs/decisions/pre-static-attributes-gate.md参照。
