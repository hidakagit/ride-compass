# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (Road Graph/Road Attributeの永続化先。PostGIS必須。SQLAlchemyの非同期エンジン
# 用にasyncpgドライバを明示する必要があるため、postgresql:// ではなく postgresql+asyncpg://
# を使う。GraphServiceは改善計画T222でrepository必須（このURLへの実接続必須）へ一本化済みで、
# ルート生成エンジンはroad_graph一本（改善計画T462でopenrouteserviceエンジンを撤去）のため、
# DATABASE_URLは常に実接続できる値が必要。DBなしで動く構成は存在しない。
DATABASE_URL=postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass

# Road Graph永続化（PostGIS）をランタイムのread-throughキャッシュとして使うか。
# trueにするとElevationAttributeService/RegionService/AccidentServiceの路面評価用
# repositoryが注入され、PBF取込バッチ（app/batch/import_pbf.py）で取得済みマークした
# 範囲では地域路面レイヤーのタイル生成等がPostGISのみで完結する（Overpassフォールバックは
# 改善計画T22で撤去済み。取込範囲外・DB障害時は空タイル/データ未整備扱いになる）。
# falseの場合、地域路面レイヤーは常に空タイルを返す（GraphService自体は本設定に関わらず
# 常にDB接続必須のため、ルート生成そのものは影響を受けない。影響するのは地域路面レイヤー・
# 区間インスペクタ等の補助エンドポイントのみ）。
ROAD_GRAPH_USE_REPOSITORY=true

# Weather (Open-Meteo requires no API key)
# OPEN_METEO_BASE_URL: defaults to Open-Meteo directly (local dev). Render's shared
# outbound IP gets rate-limited (429) by Open-Meteo because of other tenants sharing
# the same IP pool; production points this at a relay proxy (nginx on the
# self-hosted Oracle Cloud VM, see docs/osm-pbf-import.md and
# app/infrastructure/weather_client.py) that has its own dedicated IP.
# OPEN_METEO_BASE_URL=http://<oracle-vm-ip>:8080/v1/forecast

# Basemap proxy (/api/basemap): must match the origin the browser sees the
# frontend at (Next.js proxies this path to the backend, see next.config.ts).
# Default matches local dev (frontend on :3000). Leave as-is unless the
# frontend is served from a different host/port.
BASEMAP_PUBLIC_BASE_URL=http://localhost:3000/api/basemap

# Debug mode: logs external API calls (Open-Meteo/Overpass/OpenFreeMap) and tile
# cache hit/miss per event to stdout at DEBUG level. Off by default; requires a
# server restart to take effect.
DEBUG_MODE=false

# --- 本番/開発プロファイル一覧（改善計画T20、複雑度平衡レビューI-9対応） ---
# 「正の構成」が複数文書に分散していたため、代表的なプロファイルの値をここへ集約する。
# 改善計画T462（openrouteserviceエンジン撤去）で「開発（DBなし）」プロファイルは
# 選べなくなった（road_graphが唯一のエンジンで、GraphServiceは常にDB接続必須のため）。
# このファイル自体の既定値は「開発（ネイティブPG）」プロファイル。
#
# | 変数                      | 本番（Render+Oracle Cloud） | 開発（ネイティブPG）      |
# |---------------------------|------------------------------|-----------------------------|
# | DATABASE_URL              | Oracle Cloud PostGIS接続URL | localhost:5432/ridecompass |
# | ROAD_GRAPH_USE_REPOSITORY | true                         | true                        |
# | OPEN_METEO_BASE_URL       | Oracle VM上のリレープロキシ | 未設定（Open-Meteo直叩き） |
#
# 開発機でローカルDB以外を使う場合は、.envは変更せず環境変数で上書きする運用にしている
# （例: PowerShellで `$env:DATABASE_URL = "postgresql+asyncpg://ridecompass:ridecompass@localhost:5432/ridecompass"`）。
# Overpassフォールバック撤去の経緯はdocs/decisions/pre-static-attributes-gate.md 決定2改定参照。
