# backend を個別に起動するときの .env の雛形。書いた項目だけが app/config.py: Settings の既定値を上書きする。
# 既定値はそのクラスだけが持ち、ここへ値を写さない——写した値は .env へコピーされた時点で固定され、
# 既定値を直しても手元では古い値のまま効き続ける。既定のままでよい項目はコメントのまま残す。

# CORSの許可元（カンマ区切りで複数）。既定は手元で next dev を起動したときの frontend のオリジン。
# CORS_ALLOWED_ORIGINS=

# Database（PostGIS必須）。ルート生成・地図の路面/POI/事故タイル・区間インスペクタ・
# 軸スタジオはすべてこの接続から読むため、実接続できる値が要る。DBなしで動く構成は無い。
# 既定は手元のPostgreSQL。SQLAlchemyの非同期エンジン用にasyncpgドライバを明示する必要があるため、
# postgresql:// ではなく postgresql+asyncpg:// を使う。
# 開発機でローカルDB以外を使う場合は、.envは変更せず環境変数で上書きする
# （例: PowerShellで `$env:DATABASE_URL = "postgresql+asyncpg://<user>:<password>@<host>:5432/<db>"`）。
# DATABASE_URL=

# 基礎地図プロキシ（/api/basemap）の書き換え先。ブラウザから見た frontend のオリジンに合わせる
# （Next.js がこのパスを backend へ中継する。next.config.ts 参照）。既定は手元の next dev のオリジンで、
# frontend を別のホスト・ポートで配るときだけ書く。
# BASEMAP_PUBLIC_BASE_URL=

# 調査用デバッグモード。外部API呼び出し・タイルキャッシュのhit/missをDEBUGログに出力する。
# 有効にするときは次の行のコメントを外す（反映には再起動が要る）。
# DEBUG_MODE=true
