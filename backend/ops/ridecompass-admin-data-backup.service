# 本番DBの全体をObject Storageへ書き出す（admin_data_backup.sh）。
# 登録は.claude/skills/production-data/SKILL.md「DBのバックアップ」。
[Unit]
Description=RideCompass database backup to Object Storage
Requires=docker.service
After=docker.service postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ridecompass/admin-data-backup.env
ExecStart=/bin/bash /home/ubuntu/ridecompass-repo/backend/ops/admin_data_backup.sh
