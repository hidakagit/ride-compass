# 取り直せない管理データをObject Storageへ書き出す（admin_data_backup.sh）。
# 登録は.claude/skills/production-data/SKILL.md「管理データのバックアップ」。
[Unit]
Description=RideCompass admin data backup to Object Storage
Requires=docker.service
After=docker.service postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ridecompass/admin-data-backup.env
# 書き出したファイルを置く場所。dockerdがマウントできるよう、PrivateTmpではなくホストの/runに作る
# （止まると消える）。
RuntimeDirectory=ridecompass-admin-data-backup
ExecStart=/bin/bash /home/ubuntu/ridecompass-repo/backend/ops/admin_data_backup.sh
